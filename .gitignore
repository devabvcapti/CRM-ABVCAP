# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference repos (clonados para consulta, nunca parte do nosso codigo)
/atomic-crm

# estado interno de runtime do Claude Code (nao e conteudo do projeto)
.claude/scheduled_tasks.lock

# fontes comerciais (MuseoSans/MyriadPro: licenca Exljbris/Adobe, nao
# redistribuir) e de origem incerta (DaxlinePro). FiraSans tem OFL mas
# fica junto por simplicidade -- o app usa Montserrat via Google Fonts,
# nao precisa de nenhuma delas no repo. Logos e o PDF do guia (ambos
# propriedade da ABVCAP) continuam versionados.
/Design System/Fontes
