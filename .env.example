# Modelo de variáveis de ambiente — nunca comitar valores reais.
# Preencher via variáveis de ambiente do provedor de hospedagem (Vercel) e local (.env.local, git-ignorado).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Resend)
RESEND_API_KEY=

# Observabilidade
SENTRY_DSN=

# Camada de IA (Fase 4 — só após o gate de segurança)
AI_PROVIDER_API_KEY=

# Integrações OAuth (Fase 5)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
